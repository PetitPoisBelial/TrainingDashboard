{
  "name": "training-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/features/plans/model/*.test.ts src/features/training/model/*.test.ts src/components/app-shell/*.test.ts src/i18n/*.test.ts src/features/plans/server/*.test.ts src/server/db/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env.database.local --import tsx scripts/db-migrate.ts",
    "test:integration": "node --env-file-if-exists=.env.database.test.local --conditions=react-server --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.9.10",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "^4",
    "typescript": "^5"
  }
}
